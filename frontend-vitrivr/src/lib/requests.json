{
  "inputs": {
    "txt": {
      "type": "TEXT",
      "data": "Giraffe"
    }
  },
  "operations": {
    "clip": {
      "field": "clip",
      "inputs": {
        "txt": "txt"
      },
      "parameters": {
        "limit": "10"
      }
    },
    "relations": {
      "factory": "RelationExpander",
      "inputs": {
        "in": "clip"
      },
      "parameters": {
        "outgoing": "partOf"
      }
    },
    "aggregator": {
      "factory": "ScoreAggregator",
      "inputs": {
        "in": "relations"
      }
    },
    "timelookup": {
      "factory": "FieldLookup",
      "inputs": {
        "in": "aggregator"
      },
      "parameters": {
        "field": "time",
        "keys": "start, end"
      }
    },
    "desclookup": {
      "factory": "FieldLookup",
      "inputs": {
        "in": "timelookup"
      },
      "parameters": {
        "field": "clip",
        "keys": "descriptord"
      }
    },
    "filelookup": {
      "factory": "ObjectFieldLookup",
      "inputs": {
        "in": "desclookup"
      },
      "parameters": {
        "field": "file",
        "predicates": "partOf",
        "keys": "path"
      }
    }
  },
  "output": "filelookup"
}


