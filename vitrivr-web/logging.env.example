# Start the bundled collector with: npm run logging:server
# Leave the URL unset for local-only, disk-backed recording.
# Set this in .env or .env.local, then restart Vite / rebuild the deployed frontend.
VITE_LOGGING_BASE_URL=http://127.0.0.1:9092/api/interaction-logs
# Default: same-origin. Set include only if the logging backend uses cross-origin cookies.
VITE_LOGGING_CREDENTIALS=same-origin

# memory: pending uploads in worker RAM only; closing/reloading loses pending events.
# indexeddb: durable pending uploads on browser disk (default).
VITE_LOGGING_BUFFER_MODE=indexeddb
